# Environment Variables Template

# Copy this file to .env and fill in your values
# Example: cp .env.example .env

# ============================================================================
# AUDIO CONFIGURATION
# ============================================================================

# Sample rate in Hz (typically 16000 for speech recognition)
SAMPLE_RATE=16000

# Chunk size for audio processing (samples per chunk)
CHUNK_SIZE=2048

# Number of audio channels (1=mono, 2=stereo)
CHANNELS=1

# Audio format (int16 for 16-bit PCM)
AUDIO_FORMAT=int16

# ============================================================================
# API KEYS
# ============================================================================

# OpenAI API Key (required for OpenAI STT/LLM/TTS)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ============================================================================
# STT (SPEECH-TO-TEXT) CONFIGURATION
# ============================================================================

# STT Provider: whisper, google, azure
STT_PROVIDER=whisper

# Language for STT (language codes: en, es, fr, etc.)
STT_LANGUAGE=es

# ============================================================================
# LLM (LANGUAGE MODEL) CONFIGURATION
# ============================================================================

# LLM Provider: openai, claude, ollama
LLM_PROVIDER=openai

# Model name
OPENAI_MODEL=gpt-3.5-turbo

# Temperature for sampling (0.0-2.0, lower=more deterministic)
LLM_TEMPERATURE=0.7

# Maximum tokens in response
LLM_MAX_TOKENS=256

# System prompt for the LLM
SYSTEM_PROMPT=Eres un asistente de voz amable y útil. Responde de forma concisa y clara.

# ============================================================================
# TTS (TEXT-TO-SPEECH) CONFIGURATION
# ============================================================================

# TTS Provider: pyttsx3, gtts, azure
TTS_PROVIDER=pyttsx3

# Words per minute (TTS speed)
TTS_RATE=150

# Volume level (0.0-1.0)
TTS_VOLUME=1.0

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================

# Timeout for operations in seconds
OPERATION_TIMEOUT=30

# Enable debug mode (verbose logging and additional checks)
DEBUG=False
